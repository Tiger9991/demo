@using MediatR
@using Application.Features.Stats.Queries
@using Application.DTOs
@using Application.Common.Helpers
@inject IMediator Mediator
@inject IJSRuntime JSRuntime

<AnalyticsSummaryCard Title="اخر توقيت تنبيهات"
                      Value="@Value"
                      Icon="message-circle-outline"
                      CardClass="bg-info-subtle"
                      AvatarClass="bg-info"
                      InsetClass="inset-info"
                      ModalId="modal_latest_alerts"
                      OnSelected="@OpenModalAsync">
    <!-- Modal -->
    <div class="modal fade" id="modal_latest_alerts" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">اخر توقيت تنبيهات</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" dir="rtl">
                    @if (_modalRows == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (_modalRows.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="mdi mdi-database-off-outline text-muted fs-1 mb-3 d-block" style="font-size: 3rem;"></i>
                            <p class="text-muted mb-0 fs-16">لا يوجد بيانات</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle mb-0 text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>الوقت</th>
                                        <th>رقم المحطة</th>
                                        <th>المجموعة</th>
                                        <th>النوع</th>
                                        <th>الوزن (جم)</th>
                                        <th>الطول (سم)</th>
                                       @*  <th>قوة الإشارة</th>
                                        <th>عدد الإرسالات</th> *@
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int rowIndex = 0; rowIndex < _modalRows.Count; rowIndex++)
                                    {
                                        var row = _modalRows[rowIndex];
                                        <tr>
                                            <td>@(((DateTime?)row.CaptureTime).ToEgyptianArabic12Hour())</td>
                                            <td>@row.TrapNumber</td>
                                            <td>@row.GroupNumber</td>
                                            <td>@row.RodentType</td>
                                            <td>@row.Weight</td>
                                            <td>@row.Length</td>
                                            @* <td>@row.SignalStrength dBm <span class="badge bg-info-subtle text-info fs-11">@row.SignalQuality</span></td>
                                            <td>@row.NumberOfTransmissions</td> *@
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</AnalyticsSummaryCard>

@code {
    [Parameter] public int Value { get; set; }
    private List<LatestAlertDetailDto>? _modalRows;

    private async Task OpenModalAsync(string? modalId)
    {
        if (_modalRows == null)
        {
            _modalRows = await Mediator.Send(new GetLatestAlertsDetailsQuery(10));
            StateHasChanged();
        }
        await JSRuntime.InvokeVoidAsync("openAnalyticsModal", modalId, string.Empty);
    }
}
