<div class="w-100 h-100">
    <div class="card border-0 shadow-sm rounded-4 h-100 position-relative hover-elevate transition-all overflow-hidden bg-white"
         style="cursor:pointer; padding: 1.15rem 1.25rem; min-height: 125px; border-radius: 14px !important; border-top: 3px solid @AccentColor !important;"
         @onclick="() => OnCardClick()">
        
        <div class="d-flex justify-content-between align-items-start w-100 mb-2">
            <!-- Right side (RTL): Title & Badge -->
            <div class="text-end">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fs-13 fw-bold text-dark" style="color: #1E293B !important;">@Title</span>
                    @if (!string.IsNullOrEmpty(BadgeText))
                    {
                        <span class="badge px-2 py-0.5 rounded-pill fs-10 fw-bold" style="background-color: @(AccentColor)15; color: @AccentColor !important; border: 1px solid @(AccentColor)30;">
                            @BadgeText
                        </span>
                    }
                </div>

                <!-- Large Count Value -->
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <h2 class="fw-extrabold mb-0 font-outfit" style="font-size: 2rem; color: #0F172A !important; line-height: 1;">
                        @Value
                    </h2>
                    @if (TotalFleet > 0)
                    {
                        <span class="fs-11 text-muted fw-semibold">من أصل @TotalFleet</span>
                    }
                </div>
            </div>

            <!-- Left side (RTL): Dynamic Colored Icon -->
            <div class="avatar avatar-md rounded-3 d-flex align-items-center justify-content-center shadow-sm" 
                 style="width: 44px; height: 44px; flex-shrink: 0; background-color: @(AccentColor)12; border: 1px solid @(AccentColor)25;">
                <i class="mdi mdi-@ActualMdiIcon fs-22" style="color: @AccentColor !important;"></i>
            </div>
        </div>

        <!-- Concise Subtext / Summary Information -->
        @if (!string.IsNullOrEmpty(Subtext))
        {
            <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between text-muted fs-11 fw-medium" style="font-size: 11.5px; color: #64748B !important;">
                <div class="d-flex align-items-center gap-1">
                    <i class="mdi mdi-information-outline fs-13" style="color: @AccentColor;"></i>
                    <span>@Subtext</span>
                </div>
                <span class="text-primary fw-semibold hover-arrow fs-10 d-flex align-items-center gap-0.5">
                    التحليلات <i class="mdi mdi-chevron-left"></i>
                </span>
            </div>
        }

        <!-- Micro Progress Bar indicator if ProgressPercentage is set -->
        @if (ProgressPercentage > 0)
        {
            <div class="progress mt-2" style="height: 4px; border-radius: 2px; background-color: #F1F5F9;">
                <div class="progress-bar" style="width: @ProgressPercentage%; background-color: @AccentColor;"></div>
            </div>
        }
    </div>
    @ChildContent
</div>

<style>
    .hover-elevate {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
    }
    .hover-elevate:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.09) !important;
    }
    .hover-arrow {
        transition: transform 0.2s ease;
    }
    .hover-elevate:hover .hover-arrow {
        transform: translateX(-3px);
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public int TotalFleet { get; set; } = 20;
    [Parameter] public string? Subtext { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public int ProgressPercentage { get; set; } = 0;
    [Parameter] public string AccentColor { get; set; } = "#10B981";
    [Parameter] public string MdiIcon { get; set; } = "wifi";
    [Parameter] public string Icon { get; set; } = "wifi";
    [Parameter] public string CardClass { get; set; } = "bg-info-subtle";
    [Parameter] public string AvatarClass { get; set; } = "bg-info";
    [Parameter] public string InsetClass { get; set; } = "inset-info";
    [Parameter] public string? TrendClass { get; set; }
    [Parameter] public string? TrendIcon { get; set; }
    [Parameter] public string? ModalId { get; set; }
    [Parameter] public EventCallback<string?> OnSelected { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ActualMdiIcon => !string.IsNullOrEmpty(MdiIcon) && MdiIcon != "wifi" ? MdiIcon : GetFallbackIcon(Icon);

    private async Task OnCardClick()
    {
        if (string.IsNullOrEmpty(ModalId)) return;
        await OnSelected.InvokeAsync(ModalId);
    }

    private string GetFallbackIcon(string icon)
    {
        return icon switch
        {
            "checkmark-circle-2-outline" => "wifi",
            "clock-outline" => "pulse",
            "bell-outline" => "wifi-off",
            _ => "chart-box-outline"
        };
    }
}
