@using MediatR
@using Application.Features.Stats.Queries
@using Application.Features.Traps.Queries
@using Application.DTOs
@using Domain.Enums
@inject IMediator Mediator
@inject IJSRuntime JSRuntime

<div class="card border border-light-subtle shadow-sm rounded-4 bg-white p-4 d-flex flex-column h-100 overflow-hidden" dir="rtl">
    
    <!-- EXECUTIVE MAP HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="mdi mdi-map-marker-radius fs-20" style="color: #1B365D !important;"></i>
                </div>
                <div>
                    <h5 class="fw-extrabold mb-0 text-dark" style="color: #1B365D !important; font-size: 1.15rem;">الخريطة الجغرافية التفاعلية للمحطات</h5>
                    <span class="fs-12 text-muted fw-medium">التوزيع المكاني اللحظي لمحطات الطعوم الذكية ورصد الإشارات الميدانية</span>
                </div>
            </div>
        </div>

        <!-- Filter & Refresh Actions -->
        <div class="d-flex align-items-center gap-2 me-auto ms-0">
            <!-- Group Filter Dropdown -->
            <div class="position-relative">
                <select @bind="_selectedGroup" @bind:after="Refresh" class="form-select form-select-sm bg-light border-0 fw-bold fs-12 px-3 py-2 rounded-3 cursor-pointer" style="color: #1E293B !important; width: 140px; background-color: #F1F5F9 !important;">
                    <option value="">كل المجموعات</option>
                    @foreach (var g in Groups)
                    {
                        <option value="@g">المجموعة @g</option>
                    }
                </select>
            </div>

            <!-- Refresh Button -->
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 fw-semibold fs-12" @onclick="Refresh">
                <i class="mdi mdi-refresh fs-16"></i>
                <span>تحديث البيانات</span>
            </button>

            <!-- Fit All Points Button -->
            <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 fw-semibold fs-12" @onclick="FitAllPoints" style="color: #1B365D; border-color: #1B365D;">
                <i class="mdi mdi-crop-free fs-16"></i>
                <span>إظهار كافة النقاط</span>
            </button>
        </div>
    </div>

    <!-- GIS EXPLANATORY TELEMETRY BAR (توضيحات ومؤشرات الخريطة الميدانية) -->
    <div class="row g-2 mb-3 text-end fs-12">
        <div class="col-md-4">
            <div class="p-2.5 rounded-3 bg-light border d-flex align-items-center gap-2.5">
                <div class="p-2 rounded-circle bg-danger-subtle text-danger">
                    <i class="mdi mdi-fire fs-18"></i>
                </div>
                <div>
                    <span class="text-muted d-block fs-10 fw-semibold">بؤرة النشاط الأعلى</span>
                    <span class="fw-bold text-dark fs-12">@HighActivityTrapText</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-2.5 rounded-3 bg-light border d-flex align-items-center gap-2.5">
                <div class="p-2 rounded-circle bg-success-subtle text-success">
                    <i class="mdi mdi-access-point-network fs-18"></i>
                </div>
                <div>
                    <span class="text-muted d-block fs-10 fw-semibold">جودة التغطية الجغرافية</span>
                    <span class="fw-bold text-success fs-12">@CoveragePercentage% استقرار شبكة التردد (LoRa)</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-2.5 rounded-3 bg-light border d-flex align-items-center gap-2.5">
                <div class="p-2 rounded-circle bg-primary-subtle text-primary" style="color: #1B365D !important;">
                    <i class="mdi mdi-crosshairs-gps fs-18"></i>
                </div>
                <div>
                    <span class="text-muted d-block fs-10 fw-semibold">تحديث المواقع اللحظي</span>
                    <span class="fw-bold text-dark fs-12">@ConnectedCount نشطة • @OfflineCount مفصولة (إجمالي @TotalCount)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- LEAFLET MAP CONTAINER -->
    <div id="map-container" class="rounded-3 shadow-2xs border overflow-hidden position-relative flex-grow-1" style="width:100%; height:575px; min-height:480px;"></div>

</div>

@code {
    [Parameter] public List<string> Groups { get; set; } = new();
    [Parameter] public List<TrapDetailDto> InitialData { get; set; } = new();

    private string _selectedGroup = "";
    private List<TrapDetailDto> _data = new();
    private bool _isRendered = false;

    private int TotalCount => _data?.Count ?? 0;
    private int ConnectedCount => _data?.Count(d => d.IsConnected) ?? 0;
    private int OfflineCount => _data?.Count(d => d.IsOffline) ?? 0;
    private int CoveragePercentage => TotalCount > 0 ? (int)Math.Round((double)ConnectedCount / TotalCount * 100) : 0;
    private string HighActivityTrapText
    {
        get
        {
            var redTrap = _data?.FirstOrDefault(d => d.IndicatorStatus == IndicatorStatus.Red);
            if (redTrap != null)
                return $"محطة #{redTrap.TrapNumber} (مجموعة {redTrap.GroupNumber})";
            return "لا توجد بؤر نشاط حرجة";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (InitialData != null && InitialData.Any())
        {
            _data = InitialData;
        }
        else
        {
            await LoadData();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (InitialData != null && InitialData.Any() && (_data == null || !_data.Any() || string.IsNullOrEmpty(_selectedGroup)))
        {
            _data = InitialData;
            if (_isRendered)
            {
                await RenderMap();
                await Task.Delay(200);
                await FitAllPoints();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;
            if (_data == null || !_data.Any())
            {
                await LoadData();
            }
            await Task.Delay(100);
            await RenderMap();
            await Task.Delay(300);
            await FitAllPoints();
        }
    }

    private async Task LoadData()
    {
        try
        {
            _data = await Mediator.Send(new GetTrapsMapDataQuery(
                string.IsNullOrEmpty(_selectedGroup) ? null : _selectedGroup
            )) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading map data: {ex.Message}");
            _data = new();
        }
    }

    private async Task RenderMap()
    {
        try
        {
            if (_data != null && _data.Any())
                await JSRuntime.InvokeVoidAsync("renderTrapMap", _data);
            else
                await JSRuntime.InvokeVoidAsync("showMapMessage", "لا توجد بيانات لعرضها على الخريطة.");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"JS Error in RenderMap: {ex.Message}");
        }
    }

    private async Task FitAllPoints()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("fitAllTrapMapPoints");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"JS Error in FitAllPoints: {ex.Message}");
        }
    }

    public async Task Refresh()
    {
        await LoadData();
        StateHasChanged();
        await RenderMap();
        await Task.Delay(200);
        await FitAllPoints();
    }
}
