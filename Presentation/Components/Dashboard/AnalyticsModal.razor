<div class="modal fade analytics-card-modal" id="@Id" tabindex="-1" aria-labelledby="@LabelId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@LabelId">@Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="اغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="analytics-modal-placeholder">مساحة جاهزة لمحتوى @Title.</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    private string LabelId => $"{Id}Label";
}
