@page "/customers"
@rendermode InteractiveServer
@using Application.Features.Customers.Queries
@using Application.Features.Customers.Commands
@using Application.DTOs
@using Domain.Enums
@using Infrastructure.Services
@inject MediatR.IMediator Mediator
@inject IJSRuntime JSRuntime

<PageTitle>إدارة العملاء</PageTitle>

<section class="page-content customers-page" dir="rtl">
    <div class="container-fluid">

        <!-- ===== Header ===== -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <h1 class="page-title mb-0">إدارة العملاء</h1>
                <div class="status-badge">
                    <span class="status-pulse"></span>
                    <span>@_customers.Count عميل</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Export Buttons -->
                <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1"
                        @onclick="ExportExcel" disabled="@_exporting">
                    <i data-eva="download-outline" style="width:16px;height:16px;"></i>
                    <span>Excel</span>
                </button>
                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                        @onclick="ExportPdf" disabled="@_exporting">
                    <i data-eva="file-text-outline" style="width:16px;height:16px;"></i>
                    <span>PDF</span>
                </button>
                <!-- Link Group -->
                <button class="btn btn-outline-primary d-flex align-items-center gap-1"
                        @onclick="() => OpenLinkGroupModal()">
                    <i class="mdi mdi-link-variant fs-16"></i>
                    <span>ربط مجموعة</span>
                </button>
                <!-- Add Customer -->
                <button class="btn btn-primary d-flex align-items-center gap-2"
                        @onclick="OpenAddModal">
                    <i data-eva="person-add-outline" style="width:16px;height:16px;fill:white;"></i>
                    <span>إضافة عميل</span>
                </button>
            </div>
        </div>

        <!-- ===== Search Bar ===== -->
        <div class="stitch-card mb-4 p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i data-eva="search-outline" style="width:16px;height:16px;"></i>
                        </span>
                        <input type="text" class="form-control border-start-0"
                               placeholder="ابحث بالاسم أو رقم العميل أو الهاتف..."
                               @bind="_search" @bind:event="oninput"
                               @onkeyup="OnSearchChanged" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="_filterType" @bind:event="onchange">
                        <option value="">كل الأنواع</option>
                        <option value="Individual">فرد</option>
                        <option value="Company">شركة</option>
                    </select>
                </div>
                <div class="col-md-4 text-start">
                    <span class="text-muted fs-13">
                        عرض <strong>@FilteredCustomers.Count</strong> من <strong>@_customers.Count</strong> عميل
                    </span>
                </div>
            </div>
        </div>

        <!-- ===== Customers Table ===== -->
        @if (_loading)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (!FilteredCustomers.Any())
        {
            <div class="stitch-card text-center py-5">
                <i data-eva="people-outline" style="width:64px;height:64px;fill:#94a3b8;"></i>
                <p class="text-muted mt-3 mb-0 fs-16">
                    @(_customers.Any() ? "لا توجد نتائج للبحث" : "لا يوجد عملاء بعد")
                </p>
                @if (!_customers.Any())
                {
                    <button class="btn btn-primary mt-3" @onclick="OpenAddModal">
                        إضافة أول عميل
                    </button>
                }
            </div>
        }
        else
        {
            <div class="stitch-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center customers-table">
                        <thead>
                            <tr>
                                <th>م</th>
                                <th>رقم العميل</th>
                                <th>الاسم</th>
                                <th>النوع</th>
                                <th>الهاتف</th>
                                <th>البريد الإلكتروني</th>
                                <th>المجموعات</th>
                                <th>تاريخ الإضافة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < FilteredCustomers.Count; i++)
                            {
                                var idx = i + 1;
                                var c = FilteredCustomers[i];
                                <tr>
                                    <td class="text-muted fs-13">@idx</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info fw-semibold">
                                            @c.CustomerNumber
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-start" style="min-width:140px;">@c.Name</td>
                                    <td>
                                        <span class="badge @(c.CustomerType == CustomerType.Company ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">
                                            @c.CustomerTypeDisplay
                                        </span>
                                    </td>
                                    <td>@(c.Phone ?? "-")</td>
                                    <td class="text-start">
                                        @if (!string.IsNullOrEmpty(c.Email))
                                        {
                                            <a href="mailto:@c.Email" class="text-primary text-decoration-none">@c.Email</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.TrapGroupCount > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-info"
                                                    @onclick="() => OpenDetailsModal(c)"
                                                    title="عرض المجموعات">
                                                <i data-eva="layers-outline" style="width:14px;height:14px;"></i>
                                                @c.TrapGroupCount مجموعة
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-12">لا يوجد</span>
                                        }
                                    </td>
                                    <td class="text-muted fs-12">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenLinkGroupModal(c)"
                                                    title="ربط مجموعة محطات">
                                                <i class="mdi mdi-link-variant" style="font-size:14px;"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning"
                                                    @onclick="() => OpenEditModal(c)"
                                                    title="تعديل">
                                                <i data-eva="edit-2-outline" style="width:14px;height:14px;"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ConfirmDelete(c)"
                                                    title="حذف">
                                                <i data-eva="trash-2-outline" style="width:14px;height:14px;"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>

<!-- ===== Add/Edit Modal ===== -->
<div class="modal fade" id="modal_customer_form" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" dir="rtl">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">
                    <i data-eva="@(_isEditMode ? "edit-2-outline" : "person-add-outline")"
                       style="width:18px;height:18px;fill:currentColor;vertical-align:middle;margin-left:6px;"></i>
                    @(_isEditMode ? "تعديل عميل" : "إضافة عميل جديد")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="_form" OnValidSubmit="SaveCustomer">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Name"
                                       placeholder="اسم العميل أو الشركة" />
                            <ValidationMessage For="() => _form.Name" class="text-danger fs-12 mt-1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">نوع العميل <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.CustomerType">
                                <option value="@CustomerType.Individual">فرد</option>
                                <option value="@CustomerType.Company">شركة</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الهاتف</label>
                            <InputText class="form-control" @bind-Value="_form.Phone"
                                       placeholder="05XXXXXXXX" />
                            <ValidationMessage For="() => _form.Phone" class="text-danger fs-12 mt-1" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">البريد الإلكتروني</label>
                            <InputText class="form-control" @bind-Value="_form.Email"
                                       placeholder="example@domain.com" />
                            <ValidationMessage For="() => _form.Email" class="text-danger fs-12 mt-1" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">العنوان</label>
                            <InputTextArea class="form-control" @bind-Value="_form.Address"
                                           rows="2" placeholder="عنوان العميل أو الشركة" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2 fs-13">@_formError</div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(_isEditMode ? "حفظ التعديلات" : "إضافة العميل")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- ===== Details Modal ===== -->
<div class="modal fade" id="modal_customer_details" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i data-eva="layers-outline" style="width:18px;height:18px;fill:currentColor;vertical-align:middle;margin-left:6px;"></i>
                    مجموعات محطات: @_selectedCustomer?.Name
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (_selectedCustomer != null)
                {
                    <!-- Customer Info -->
                    <div class="row g-2 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <div class="fs-12 text-muted">رقم العميل</div>
                                <div class="fw-bold text-info">@_selectedCustomer.CustomerNumber</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <div class="fs-12 text-muted">النوع</div>
                                <div class="fw-bold">@_selectedCustomer.CustomerTypeDisplay</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <div class="fs-12 text-muted">عدد المجموعات</div>
                                <div class="fw-bold text-primary">@_selectedCustomer.TrapGroupCount</div>
                            </div>
                        </div>
                    </div>

                    <!-- Groups List -->
                    @if (_selectedCustomer.TrapGroupNumbers.Any())
                    {
                        <h6 class="fw-bold mb-3">المجموعات المرتبطة:</h6>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (var grp in _selectedCustomer.TrapGroupNumbers)
                            {
                                <span class="badge bg-primary-subtle text-primary fs-13 px-3 py-2">
                                    <i data-eva="layers-outline" style="width:12px;height:12px;fill:currentColor;"></i>
                                    المجموعة @grp
                                </span>
                            }
                        </div>
                    }

                    <!-- Traps Table -->
                    @if (_detailTraps == null)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                        </div>
                    }
                    else if (!_detailTraps.Any())
                    {
                        <div class="text-center text-muted py-3">لا توجد محطات مرتبطة</div>
                    }
                    else
                    {
                        <h6 class="fw-bold mb-3">المحطات (@_detailTraps.Count):</h6>
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle mb-0 text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>م</th>
                                        <th>المجموعة</th>
                                        <th>رقم المحطة</th>
                                        <th>الحالة</th>
                                        <th>البطارية</th>
                                        <th>آخر دخول</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _detailTraps.Count; i++)
                                    {
                                        var t = _detailTraps[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@t.TrapGroup</td>
                                            <td>@t.TrapNumber</td>
                                            <td>
                                                 <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                                     @(t.IsActive ? "متصلة" : "غير متصلة")
                                                 </span>
                                            </td>
                                            <td>
                                                <span class="@(t.BatteryPercentage < 20 ? "text-danger" : t.BatteryPercentage < 50 ? "text-warning" : "text-success") fw-semibold">
                                                    @t.BatteryPercentage%
                                                </span>
                                            </td>
                                            <td class="fs-12">@(t.LastEntryDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== Delete Confirm Modal ===== -->
<div class="modal fade" id="modal_customer_delete" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" dir="rtl">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center pb-4">
                <div class="mb-3">
                    <i data-eva="alert-triangle-outline" style="width:48px;height:48px;fill:#ef4444;"></i>
                </div>
                <h6 class="fw-bold mb-2">تأكيد الحذف</h6>
                <p class="text-muted fs-13 mb-4">
                    هل أنت متأكد من حذف العميل <strong>@_customerToDelete?.Name</strong>؟
                    <br/>سيتم فك ربط مجموعات المحطات المرتبطة به.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteCustomer" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm"></span> }
                        حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Link Customer Group Modal ===== -->
<LinkCustomerGroupModal @ref="_linkModal" OnLinked="LoadCustomers" />

@code {
    private List<CustomerDto> _customers = new();
    private bool _loading = true;
    private bool _saving = false;
    private bool _exporting = false;
    private string _search = "";
    private string _filterType = "";
    private string? _formError;
    private bool _isEditMode = false;

    // Form
    private CustomerUpsertDto _form = new();

    // Delete
    private CustomerDto? _customerToDelete;

    // Link Modal
    private LinkCustomerGroupModal? _linkModal;

    // Details
    private CustomerDto? _selectedCustomer;
    private List<TrapDto>? _detailTraps;

    // Filtered list
    private List<CustomerDto> FilteredCustomers => _customers
        .Where(c =>
            (string.IsNullOrEmpty(_search) ||
             c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             c.CustomerNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             (c.Phone != null && c.Phone.Contains(_search)) ||
             (c.Email != null && c.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            &&
            (string.IsNullOrEmpty(_filterType) || c.CustomerType.ToString() == _filterType)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        _customers = await Mediator.Send(new GetAllCustomersQuery());
        _loading = false;
    }

    private void OnSearchChanged() => StateHasChanged();

    // ===== Add =====
    private async Task OpenAddModal()
    {
        _isEditMode = false;
        _form = new CustomerUpsertDto();
        _formError = null;
        await JSRuntime.InvokeVoidAsync("openAnalyticsModal", "modal_customer_form", string.Empty);
    }

    // ===== Edit =====
    private async Task OpenEditModal(CustomerDto customer)
    {
        _isEditMode = true;
        _form = new CustomerUpsertDto
        {
            Id = customer.Id,
            Name = customer.Name,
            CustomerType = customer.CustomerType,
            Email = customer.Email,
            Phone = customer.Phone,
            Address = customer.Address
        };
        _formError = null;
        await JSRuntime.InvokeVoidAsync("openAnalyticsModal", "modal_customer_form", string.Empty);
    }

    // ===== Save (Add or Edit) =====
    private async Task SaveCustomer()
    {
        _saving = true;
        _formError = null;
        try
        {
            if (_isEditMode)
            {
                var ok = await Mediator.Send(new UpdateCustomerCommand(_form));
                if (!ok) _formError = "فشل التعديل، تحقق من البيانات.";
            }
            else
            {
                await Mediator.Send(new CreateCustomerCommand(_form));
            }

            if (_formError == null)
            {
                await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('modal_customer_form'))?.hide()");
                await LoadCustomers();
            }
        }
        catch (Exception ex)
        {
            _formError = $"خطأ: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ===== Delete =====
    private async Task ConfirmDelete(CustomerDto customer)
    {
        _customerToDelete = customer;
        await JSRuntime.InvokeVoidAsync("openAnalyticsModal", "modal_customer_delete", string.Empty);
    }

    private async Task DeleteCustomer()
    {
        if (_customerToDelete == null) return;
        _saving = true;
        try
        {
            await Mediator.Send(new DeleteCustomerCommand(_customerToDelete.Id));
            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('modal_customer_delete'))?.hide()");
            await LoadCustomers();
        }
        finally
        {
            _saving = false;
            _customerToDelete = null;
        }
    }

    // ===== Details =====
    private async Task OpenDetailsModal(CustomerDto customer)
    {
        _selectedCustomer = customer;
        _detailTraps = null;
        await JSRuntime.InvokeVoidAsync("openAnalyticsModal", "modal_customer_details", string.Empty);
        _detailTraps = await Mediator.Send(new GetCustomerTrapsQuery(customer.Id));
        StateHasChanged();
    }

    // ===== Link Group Modal =====
    private async Task OpenLinkGroupModal(CustomerDto? customer = null)
    {
        if (_linkModal != null)
        {
            await _linkModal.OpenModalAsync(customer?.Id);
        }
    }

    // ===== Export =====
    private async Task ExportExcel()
    {
        _exporting = true;
        try
        {
            var exportService = new CustomerExportService();
            var bytes = exportService.ExportToExcel(FilteredCustomers);
            var fileName = $"العملاء_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(bytes), fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ExportPdf()
    {
        _exporting = true;
        try
        {
            var exportService = new CustomerExportService();
            var bytes = exportService.ExportToPdf(FilteredCustomers);
            var fileName = $"العملاء_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
            await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(bytes), fileName, "application/pdf");
        }
        finally
        {
            _exporting = false;
        }
    }
}
