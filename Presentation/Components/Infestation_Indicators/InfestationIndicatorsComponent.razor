@inject IJSRuntime JSRuntime
@using System.Text.Json

<section class="page-content infestation-indicators-page" dir="rtl">
    <!-- Top Header Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <h1 class="page-title mb-0">مؤشرات الإصابة (Infestation Indicators)</h1>
            <div class="status-badge">
                <span class="status-pulse"></span>
                <span>نشط الآن</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="info-badge">
                <span class="material-symbols-outlined text-muted" style="vertical-align: middle;">calendar_month</span>
                <span style="font-size: 14px; font-weight: 600; color: #334155; margin-right: 4px;">آخر 30 يوم</span>
            </div>
        </div>
    </div>

    <!-- KPI Row -->
    <div class="row g-3 mb-4">
        <!-- KPI 1 -->
        <div class="col-md-4">
            <div class="stitch-card position-relative overflow-hidden h-100" style="border-right: 4px solid #ba1a1a !important;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <p class="text-slate-500 mb-0 fs-12 fw-semibold" style="color: #64748b;">مؤشر شدة الإصابة العام</p>
                    <span class="material-symbols-outlined text-danger" style="font-size: 20px;">warning</span>
                </div>
                <h3 class="fw-bold mb-0 text-danger" style="font-size: 1.7rem;">68%</h3>
                <span class="badge bg-danger-subtle text-danger border border-danger mt-1">خطورة عالية (High Risk)</span>
            </div>
        </div>
        <!-- KPI 2 -->
        <div class="col-md-4">
            <div class="stitch-card position-relative overflow-hidden h-100" style="border-right: 4px solid #003527 !important;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <p class="text-slate-500 mb-0 fs-12 fw-semibold" style="color: #64748b;">معدل التفشي الأسبوعي</p>
                    <span class="material-symbols-outlined text-success" style="font-size: 20px;">trending_up</span>
                </div>
                <h3 class="fw-bold mb-0 text-slate-800" style="font-size: 1.7rem; color: #0f172a;">+12%</h3>
                <span class="fs-12 text-muted mt-1 d-block">زيادة مقارنة بالأسبوع الماضي</span>
            </div>
        </div>
        <!-- KPI 3 -->
        <div class="col-md-4">
            <div class="stitch-card position-relative overflow-hidden h-100" style="border-right: 4px solid #4a2400 !important;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <p class="text-slate-500 mb-0 fs-12 fw-semibold" style="color: #64748b;">عدد القطاعات عالية الخطورة</p>
                    <span class="material-symbols-outlined text-warning" style="font-size: 20px;">my_location</span>
                </div>
                <h3 class="fw-bold mb-0 text-slate-800" style="font-size: 1.7rem; color: #0f172a;">5 قطاعات</h3>
                <span class="fs-12 text-danger mt-1 d-block">بحاجة لتدخل فوري للفرق</span>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <!-- Radar Chart -->
        <div class="col-lg-6">
            <div class="stitch-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">مقارنة شدة الإصابة بين القطاعات</h5>
                </div>
                <div id="radarChart"></div>
            </div>
        </div>
        <!-- Waterfall / Bar Chart -->
        <div class="col-lg-6">
            <div class="stitch-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">تطور مؤشر الإصابة عبر الزمن</h5>
                </div>
                <div id="barChart"></div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="stitch-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">جدول ترتيب المجموعات حسب الأولوية</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover text-right" style="direction: rtl;">
                <thead>
                    <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <th class="py-2 px-3">المجموعة / القطاع</th>
                        <th class="py-2 px-3">مستوى الخطورة</th>
                        <th class="py-2 px-3">إجمالي المصيدات</th>
                        <th class="py-2 px-3">الإجراء المقترح</th>
                        <th class="py-2 px-3">معرف النظام</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="align-middle">
                        <td class="py-3 px-3 fw-bold">القطاع الشمالي (أ)</td>
                        <td class="py-3 px-3"><span class="badge bg-danger">حرج (Critical)</span></td>
                        <td class="py-3 px-3 font-monospace">450</td>
                        <td class="py-3 px-3 text-primary fw-semibold">نشر فرق التدخل السريع</td>
                        <td class="py-3 px-3 font-monospace text-muted">SEC-N-01</td>
                    </tr>
                    <tr class="align-middle">
                        <td class="py-3 px-3 fw-bold">القطاع الشرقي (ب)</td>
                        <td class="py-3 px-3"><span class="badge bg-danger-subtle text-danger border border-danger">عالي (High)</span></td>
                        <td class="py-3 px-3 font-monospace">312</td>
                        <td class="py-3 px-3 text-primary fw-semibold">تكثيف المراقبة اليومية</td>
                        <td class="py-3 px-3 font-monospace text-muted">SEC-E-02</td>
                    </tr>
                    <tr class="align-middle">
                        <td class="py-3 px-3 fw-bold">المنطقة المركزية</td>
                        <td class="py-3 px-3"><span class="badge bg-warning-subtle text-warning border border-warning">متوسط (Moderate)</span></td>
                        <td class="py-3 px-3 font-monospace">145</td>
                        <td class="py-3 px-3 text-muted">المراجعة الدورية المعتادة</td>
                        <td class="py-3 px-3 font-monospace text-muted">SEC-C-00</td>
                    </tr>
                    <tr class="align-middle">
                        <td class="py-3 px-3 fw-bold">القطاع الغربي (ج)</td>
                        <td class="py-3 px-3"><span class="badge bg-warning-subtle text-warning border border-warning">متوسط (Moderate)</span></td>
                        <td class="py-3 px-3 font-monospace">98</td>
                        <td class="py-3 px-3 text-muted">صيانة المصيدات</td>
                        <td class="py-3 px-3 font-monospace text-muted">SEC-W-03</td>
                    </tr>
                    <tr class="align-middle">
                        <td class="py-3 px-3 fw-bold">القطاع الجنوبي (د)</td>
                        <td class="py-3 px-3"><span class="badge bg-success-subtle text-success border border-success">منخفض (Low)</span></td>
                        <td class="py-3 px-3 font-monospace">24</td>
                        <td class="py-3 px-3 text-muted">المراقبة الروتينية</td>
                        <td class="py-3 px-3 font-monospace text-muted">SEC-S-04</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var labels = JsonSerializer.Serialize(new[] { "Sector A", "Sector B", "Sector C", "Sector D", "Sector E" });
            var current = JsonSerializer.Serialize(new[] { 85, 65, 40, 20, 55 });
            var historical = JsonSerializer.Serialize(new[] { 60, 50, 45, 30, 40 });

            var categories = JsonSerializer.Serialize(new[] { "الأسبوع 1", "الأسبوع 2", "الأسبوع 3", "الأسبوع 4", "الأسبوع 5", "الحالي" });
            var values = JsonSerializer.Serialize(new[] { 5, 12, -3, 8, -5, 12 });

            await JSRuntime.InvokeVoidAsync("renderInfestationRadarChart", "radarChart", labels, current, historical);
            await JSRuntime.InvokeVoidAsync("renderInfestationBarChart", "barChart", categories, values);
        }
    }
}
