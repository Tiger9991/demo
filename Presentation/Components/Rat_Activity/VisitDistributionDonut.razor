@using ApexCharts
@using Application.DTOs
@using Application.Features.Stats.Queries
@using Application.Features.Traps.Queries
@using Domain.Enums
@using Domain.Extensions
@inject MediatR.IMediator Mediator
@using Microsoft.EntityFrameworkCore;


<div class="visit-distribution-donut h-100 d-flex flex-column justify-between">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="font-headline-sm text-headline-sm mb-0">توزيع الزيارات حسب النوع</h3>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex align-items-center justify-content-center h-100 py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_data == null || !_data.Any() || _totalVisits == 0)
    {
        <div class="alert alert-info border-0 rounded-xl bg-slate-50 text-center py-4">لا توجد بيانات.</div>
    }
    else
    {
        <div class="flex-1 d-flex flex-column align-items-center justify-content-center">
            <!-- ApexChart Donut -->
            <div class="w-100 position-relative d-flex justify-content-center" style="max-height: 220px;">
                <ApexChart TItem="RodentTypeDistributionDto"
                           Height="220"
                           Options="_chartOptions">
                    <ApexPointSeries TItem="RodentTypeDistributionDto"
                                     Items="@_data"
                                     SeriesType="SeriesType.Donut"
                                     Name="الزيارات"
                                     XValue="e => GetArabicName(e.RodentType)"
                                     YValue="e => e.Count" />
                </ApexChart>
                
                <!-- Center Text Overlay -->
                <div class="position-absolute d-flex flex-column align-items-center justify-content-center" style="top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                    <span class="fs-4 fw-bold font-outfit text-slate-800 leading-none">@FormatNumber(_totalVisits)</span>
                    <span class="text-xs text-slate-400">إجمالي الزيارات</span>
                </div>
            </div>

            <!-- Custom Legend (Stitch style) -->
            <div class="mt-4 w-100 space-y-1">
                @foreach (var item in _data)
                {
                    var color = GetColor(item.RodentType);
                    <div class="d-flex justify-content-between align-items-center text-sm py-1 border-bottom border-slate-50">
                        <div class="d-flex align-items-center gap-2">
                            <div class="w-3 h-3 rounded-full" style="background-color: @color; width: 10px; height: 10px; border-radius: 50%;"></div>
                            <img src="@GetRodentIconPath(item.RodentType)" alt="@item.RodentType" style="width: 32px; height: 32px; object-fit: cover;" />
                            <span class="text-slate-600 font-medium">@GetArabicName(item.RodentType)</span>
                        </div>
                        <span class="fw-bold text-slate-800">@item.Percentage%</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Group { get; set; } = "";

    private List<RodentTypeDistributionDto> _data = new();
    private string _selectedGroup = "";
    private bool _isLoading = false;
    private int _totalVisits = 0;

    private ApexChartOptions<RodentTypeDistributionDto> _chartOptions = new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Background = "transparent"
        },
        Legend = new Legend { Show = false },
        DataLabels = new DataLabels { Enabled = false },
        Stroke = new Stroke { Width = 2, Colors = new List<string> { "#ffffff" } },
        PlotOptions = new PlotOptions
        {
            Pie = new PlotOptionsPie
            {
                Donut = new PlotOptionsDonut
                {
                    Size = "75%",
                    Labels = new DonutLabels { Show = false }
                }
            }
        }
    };

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        _data = await Mediator.Send(new GetRodentTypeDistributionQuery(
            string.IsNullOrEmpty(_selectedGroup) ? null : _selectedGroup
        ));

        _totalVisits = _data.Sum(d => d.Count);

        // Assign colors based on rodent type order in data
        _chartOptions.Colors = _data.Select(d => GetColor(d.RodentType)).ToList();

        _isLoading = false;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        _selectedGroup = Group;
        await LoadData();
    }

    private string GetColor(string type)
    {
        var parsed = RodentTypeExtensions.ParseFromString(type) ?? RodentType.Unknown;
        return parsed switch
        {
            RodentType.NormalRat => "#2563eb",     // Primary blue
            RodentType.ClimbingRat => "#f97316",   // Tertiary orange
            RodentType.NorwegianRat => "#10b981",  // Secondary green
            RodentType.Unknown => "#64748b",       // Slate gray
            _ => "#6c757d"
        };
    }

    private string GetArabicName(string type)
    {
        var parsed = RodentTypeExtensions.ParseFromString(type);
        if (parsed.HasValue)
        {
            return parsed.Value.GetDisplayName();
        }
        return type;
    }

    private string FormatNumber(int value)
    {
        if (value >= 1000)
        {
            return (value / 1000.0).ToString("N1") + "k";
        }
        return value.ToString();
    }

    private string GetRodentIconPath(string rodentType)
    {
        var parsed = RodentTypeExtensions.ParseFromString(rodentType) ?? RodentType.Unknown;
        return parsed switch
        {
            RodentType.NormalRat => "/assets/images/house_mouse.jpg",
            RodentType.ClimbingRat => "/assets/images/climbing_rat.jpg",
            RodentType.NorwegianRat => "/assets/images/norwegian_rat.jpg",
            RodentType.Unknown => "/assets/images/unknown_rodent.jpg",
            _ => "/assets/images/unknown_rodent.jpg"
        };
    }
}
